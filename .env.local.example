# Copy to .env.local and fill in values.
# .env.local is gitignored — never commit credentials.
#
# Usage: make run-sample-remote

MLFLOW_TRACKING_URI=https://your-mlflow-instance.example.com/mlflow
MLFLOW_AUTH_TOKEN=sha256~your-token-here
MLFLOW_WORKSPACE=your-namespace
# Set to true only for self-signed certificates (e.g., OpenShift dev clusters).
MLFLOW_INSECURE_SKIP_TLS_VERIFY=false
# Set to true to leave demo-created prompts/experiments/MCP servers in place
# for manual inspection instead of deleting them at the end of the run.
MLFLOW_DEMO_NO_CLEANUP=false
